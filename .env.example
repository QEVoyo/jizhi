# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 模型：deepseek-flash（V4.1 Flash，文本与识图同一个模型；不填走代码默认）
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_VISION_MODEL=deepseek-flash
# 思考模式：默认关（首字 ~0.6s，与旧 deepseek-chat 档一致）；设 1 开启（首字 1~13s、输出 token 翻数倍）
# DEEPSEEK_THINKING=0
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 邮箱配置
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_USER=your_email@qq.com
EMAIL_PASSWORD=your_smtp_password
EMAIL_RECEIVER=your_email@qq.com

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 火山引擎（豆包）
VOLC_ACCESS_KEY=your_volc_access_key
VOLC_SECRET_KEY=your_volc_secret_key
VOLC_ROLE_ENDPOINT_ID=your_endpoint_id
VOLC_API_KEY=your_volc_api_key
ARK_API_KEY=your_ark_api_key

# 科大讯飞语音
XUNFEI_APPID=your_xunfei_appid
XUNFEI_API_KEY=your_xunfei_api_key
XUNFEI_API_SECRET=your_xunfei_api_secret

# 分享链接域名（外观码 /theme 直达页；不配则自动用当前站点域名，上线后无需设置）
# VITE_SHARE_BASE_URL=https://your-domain.com
